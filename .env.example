# Where the SQLite file lives. Unset, it is ./data/airk.db, which is right for
# local development. In a container this MUST point at a mounted volume, or the
# demo school is recreated from seed on every deploy.
AIRK_DB_PATH=/data/airk.db

# Puts the whole site behind one shared password: the marketing pages, the
# sign-in page, the student and staff areas, and the public family take-homes.
# Leave it unset and there is no gate at all, which is the correct setting for
# local development and for a deployment meant to be public.
AIRK_SITE_PASSWORD=
