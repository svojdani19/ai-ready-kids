# Where the SQLite file lives. Unset, it is ./data/airk.db, which is right for
# local development. In a container this MUST point at a mounted volume, or the
# demo school is recreated from seed on every deploy.
AIRK_DB_PATH=/data/airk.db

# Puts the whole site behind one shared password: the marketing pages, the
# sign-in page, the student and staff areas, and the public family take-homes.
# Leave it unset and there is no gate at all, which is the correct setting for
# local development and for a deployment meant to be public.
AIRK_SITE_PASSWORD=

# The demonstration seats: student, teacher and administrator, one click each.
#
# Unset, the seats are open to anyone who can load the page — which is the
# right default for local development and for the test suite, and the wrong
# one for a link you have sent to a school. Set it and a visitor types this
# once before any seat opens; email sign-in is behind it too, since it reaches
# the same seats.
#
# This is not a staff credential and not the site gate above. It is the reason
# a forwarded link cannot make a stranger an administrator in one click.
AIRK_DEMO_PASSWORD=
